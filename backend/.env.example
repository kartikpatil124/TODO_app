# Backend Environment Variables
PORT=5005
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/smart-productivity
JWT_SECRET=your_jwt_secret_here

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5005

# Google OAuth (for Google Login & Google Drive backup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5005/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5005/api/drive/callback

# SMTP Email Configuration (for OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nexus OS" <noreply@nexus-os.com>

# Security
TOKEN_ENCRYPTION_KEY=
